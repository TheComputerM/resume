{
  "name": "@thecomputerm/resume",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "resume serve -d docs -r cv.json -t @jsonresume/jsonresume-theme-consultant-polished",
    "cv": "resume export docs/cv.html -r cv.json -t @jsonresume/jsonresume-theme-consultant-polished",
    "lint": "resume validate -r cv.json && resume audit cv.json --theme @jsonresume/jsonresume-theme-consultant-polished",
    "preresume": "bun run convert.ts",
    "resume": "uv run rendercv render rendercv.yaml -nopng -nomd --pdf-path ./docs/resume.pdf"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@jsonresume/jsonresume-theme-consultant-polished": "^1.0.4",
    "resume-cli": "^3.8.3"
  }
}
